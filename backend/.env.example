# ---- Server -----------------------------------------------------------
PORT=4000
NODE_ENV=development

# Set to true only when the API really sits behind a reverse proxy, so that
# X-Forwarded-For can be trusted. Trusting it otherwise lets anyone spoof
# their IP past the rate limiter.
TRUST_PROXY=false

# ---- Auth -------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=2h
BCRYPT_ROUNDS=10

# Failed attempts per IP on /api/auth/* before a 429. Successful logins are
# not counted, so a shared office IP is not locked out by normal use.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# ---- Database ---------------------------------------------------------
# SQLite file path, relative to the backend/ folder.
DATABASE_PATH=./data/dealership.db

# ---- CORS -------------------------------------------------------------
# Comma-separated list of allowed origins, or * for any.
CORS_ORIGIN=http://localhost:5173

# ---- Seed data --------------------------------------------------------
SEED_ADMIN_EMAIL=admin@dealership.test
SEED_ADMIN_PASSWORD=Admin123!

# ---- Single-service mode ----------------------------------------------
# When true, this API also serves the built frontend from SPA_DIST_PATH, so a
# deployment can be one service instead of two. Off in development, where Vite
# serves the frontend itself.
SERVE_SPA=false
SPA_DIST_PATH=../frontend/dist
